# ─────────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사해서 쓴다.  cp .env.example .env
#
#   .env         → .gitignore 처리됨. 실제 값이 들어간다. 절대 커밋하지 않는다.
#   .env.example → 커밋된다. 값이 아니라 "어떤 키가 필요한가" 만 적는다.
#
# 여기에 실제 비밀값을 적지 않는다. 형식만 보여준다.
# ─────────────────────────────────────────────────────────────

# ── 로컬 개발 (docker-compose 와 BE 가 같이 읽는다) ────────────
# 아래 값은 localhost 전용이라 그대로 써도 된다.
DB_NAME=leoneferito
DB_USERNAME=leoneferito
DB_PASSWORD=leoneferito_local_only
DB_HOST=localhost
DB_PORT=5432

SERVER_PORT=8080

# ── FE ────────────────────────────────────────────────────────
# Next.js 는 NEXT_PUBLIC_ 접두사가 붙은 값만 브라우저로 내려보낸다.
# 즉 여기 넣는 값은 전부 공개된다 — 비밀값을 NEXT_PUBLIC_ 으로 넣지 않는다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ── 운영에서만 필요 (Phase 7) ─────────────────────────────────
# 로컬에서는 비워 둔다. 운영 .env 는 서버에서 스크립트로 생성한다.
# DB_POOL_MAX=10

# ── 아직 결정되지 않아 비어 있는 것들 ─────────────────────────
# 결제(Phase 4) — D1 이 커머스로 확정되고 PG 계약이 끝난 뒤에 채운다.
#   설정이 비어 있으면 결제만 거절하고 사이트는 정상 동작한다 (fail closed).
# PAYMENT_API_KEY=
# PAYMENT_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# 이미지 저장(D7 미확정) — S3 를 쓰기로 하면 채운다.
# AWS_REGION=ap-northeast-2
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# 간편 로그인(Phase 5) — 고객이 플랫폼 앱 등록을 해준 뒤에 채운다.
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
