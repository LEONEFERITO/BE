# 서버 앞의 문 하나 — 손님 화면(정적 파일)과 API 를 같은 Caddy 가 받는다 (2026-10-12, Lightsail 한 대 배포).
#
# 도메인은 .env 에서 온다:
#   SITE_ADDRESSES  손님 화면 주소들. 오픈 전 "new.leoneferito.kr", 오픈 날 "leoneferito.kr, www.leoneferito.kr, new.leoneferito.kr"
#                   (www · new 는 대표 주소로 넘긴다 — 인증서를 받아야 넘길 수 있어서 목록에 둔다)
#   SITE_DOMAIN     대표 주소(www 를 이리로 보낸다). 오픈 전 new.leoneferito.kr, 오픈 날 leoneferito.kr
#   API_DOMAIN      api.leoneferito.kr
#   SITE_ROBOTS     검색 노출. 오픈 전 "noindex, nofollow", 오픈 날 "all"
#
# Caddy 가 하는 일:
#   · HTTPS 인증서 자동 발급·갱신 (Let's Encrypt) — 각 주소의 DNS 가 이 서버를 가리켜야 받는다
#   · http → https 리다이렉트, 압축
#   · API 로 X-Forwarded-* 헤더 전달 — 그래서 application.yml 의 forward-headers-strategy 가 framework 이고,
#     세션 쿠키가 secure 로 나간다.

# ── 손님 화면 — 빌더(front-builder)가 만든 정적 파일 ─────────────
{$SITE_ADDRESSES} {
	encode zstd gzip

	# www 로 들어오면 대표 주소로 (오픈 전에는 www 주소가 없어 이 줄이 일하지 않는다)
	@www host www.{$SITE_DOMAIN}
	redir @www https://{$SITE_DOMAIN}{uri} permanent

	# 오픈 뒤 옛 미리보기 주소(new.)로 들어오면 정식 주소로 — 즐겨찾기 · 공유 링크가 끊기지 않게.
	# API 는 정식 주소에서 오는 요청만 받는다(CORS). new. 에 화면을 그대로 두면 로그인 · 주문이 막힌다.
	# 오픈 전(SITE_DOMAIN=new.leoneferito.kr)에는 new.new. 주소가 없어 이 줄이 일하지 않는다.
	@preview host new.{$SITE_DOMAIN}
	redir @preview https://{$SITE_DOMAIN}{uri} permanent

	# 빌더가 릴리스를 만들 때마다 current 링크만 바꾼다. 반쯤 바뀐 사이트는 보이지 않는다.
	root * /srv/site/current

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# 검색 노출 헤더. 기본 all(2026-10-26 허용) — 오픈 전처럼 막으려면 .env 의 SITE_ROBOTS 를 "noindex, nofollow" 로.
		X-Robots-Tag "{$SITE_ROBOTS}"
		# 1년 HTTPS 고정 — 정식 도메인(leoneferito.kr)으로 운영 중이라 켠다(2026-11-04 오픈 전 보안 점검). API 는 Spring 이 이미 보낸다.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# 쓰지 않는 기기 권한은 끈다 — 이 사이트는 카메라 · 마이크 · 위치를 쓰지 않는다(반품 사진은 파일 고르기)
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
		# 콘텐츠 보안 정책 — 결제창(토스 · 나이스페이) · 소셜 로그인을 깨지 않는 항목만:
		#   다른 사이트가 이 화면을 틀 안에 넣지 못하게(클릭재킹), <base> 로 주소를 바꾸지 못하게, 플러그인(object) 금지.
		#   스크립트 출처 제한(script-src)은 결제창 출처를 하나하나 확인한 뒤에 따로 켠다 — 오픈 직전에 결제를 막을 위험이 있다.
		Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
	}

	# 이름에 내용 해시가 붙는 파일은 1년 캐시. 나머지(HTML · 사진)는 매번 바뀌었는지 확인한다(ETag).
	@hashed path /_next/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@other not path /_next/static/*
	header @other Cache-Control "public, max-age=0, must-revalidate"

	# 정적 내보내기는 /products/ → /products/index.html 이다(next.config trailingSlash).
	# 폴더 주소에 / 가 빠지면 file_server 가 / 를 붙여 돌려보낸다.
	file_server

	# 없는 주소는 Next 가 만든 404 화면으로 (상태 코드는 404 그대로)
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}

	# 접속 기록 — 방침대로 3개월(2160h) 보관 뒤 지운다(통신비밀보호법). caddy-data 볼륨에 남아 재시작해도 이어진다.
	# 쿠키 · Authorization 헤더는 Caddy 가 기본으로 가린다. 재설정 링크의 토큰은 주소의 # 뒤라 서버로 오지 않는다.
	log {
		output file /data/logs/site.log {
			roll_size 50MiB
			roll_keep_for 2160h
		}
		format json
	}
}

# ── API ──────────────────────────────────────────────────────
{$API_DOMAIN} {
	encode zstd gzip

	# 업로드 상한과 맞춘다 — 프록시가 먼저 끊어야 큰 요청이 API 까지 오지 않는다.
	# 메인 배너 영상 업로드(관리자, V29)만 32MB(spring max-request-size), 나머지(이미지 · 반품 사진 · 모든 요청)는 12MB.
	@videoUpload path /api/admin/media/video
	request_body @videoUpload {
		max_size 32MB
	}
	@otherRequests not path /api/admin/media/video
	request_body @otherRequests {
		max_size 12MB
	}

	reverse_proxy api:8080 {
		# API 가 죽었을 때 Caddy 가 502 로 답한다. 헬스체크는 compose 가 본다.
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}

	header {
		# 서버 종류를 굳이 알려주지 않는다.
		-Server
		# HTTPS 고정(HSTS)은 Spring Security 가 이미 보낸다(max-age=31536000; includeSubDomains) — 여기서 겹쳐 보내지 않는다.
		# JSON · 이미지만 내보내는 곳이라 문서로 열려도 아무것도 실행되지 않게
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		Referrer-Policy no-referrer
	}

	# 접속 기록 — 방침대로 3개월(2160h) 보관 뒤 지운다(통신비밀보호법). caddy-data 볼륨에 남아 재시작해도 이어진다.
	# 쿠키 · Authorization 헤더는 Caddy 가 기본으로 가린다. 재설정 링크의 토큰은 주소의 # 뒤라 서버로 오지 않는다.
	log {
		output file /data/logs/api.log {
			roll_size 50MiB
			roll_keep_for 2160h
		}
		format json
	}
}
