# 서버 앞의 문 하나 — 손님 화면(정적 파일)과 API 를 같은 Caddy 가 받는다 (2026-10-12, Lightsail 한 대 배포).
#
# 도메인은 .env 에서 온다:
#   SITE_ADDRESSES  손님 화면 주소들. 오픈 전 "new.leoneferito.kr", 오픈 날 "leoneferito.kr, www.leoneferito.kr, new.leoneferito.kr"
#                   (www · new 는 대표 주소로 넘긴다 — 인증서를 받아야 넘길 수 있어서 목록에 둔다)
#   SITE_DOMAIN     대표 주소(www 를 이리로 보낸다). 오픈 전 new.leoneferito.kr, 오픈 날 leoneferito.kr
#   API_DOMAIN      api.leoneferito.kr
#   SITE_ROBOTS     검색 노출. 오픈 전 "noindex, nofollow", 오픈 날 "all"
#
# Caddy 가 하는 일:
#   · HTTPS 인증서 자동 발급·갱신 (Let's Encrypt) — 각 주소의 DNS 가 이 서버를 가리켜야 받는다
#   · http → https 리다이렉트, 압축
#   · API 로 X-Forwarded-* 헤더 전달 — 그래서 application.yml 의 forward-headers-strategy 가 framework 이고,
#     세션 쿠키가 secure 로 나간다.

# ── 손님 화면 — 빌더(front-builder)가 만든 정적 파일 ─────────────
{$SITE_ADDRESSES} {
	encode zstd gzip

	# www 로 들어오면 대표 주소로 (오픈 전에는 www 주소가 없어 이 줄이 일하지 않는다)
	@www host www.{$SITE_DOMAIN}
	redir @www https://{$SITE_DOMAIN}{uri} permanent

	# 오픈 뒤 옛 미리보기 주소(new.)로 들어오면 정식 주소로 — 즐겨찾기 · 공유 링크가 끊기지 않게.
	# API 는 정식 주소에서 오는 요청만 받는다(CORS). new. 에 화면을 그대로 두면 로그인 · 주문이 막힌다.
	# 오픈 전(SITE_DOMAIN=new.leoneferito.kr)에는 new.new. 주소가 없어 이 줄이 일하지 않는다.
	@preview host new.{$SITE_DOMAIN}
	redir @preview https://{$SITE_DOMAIN}{uri} permanent

	# 빌더가 릴리스를 만들 때마다 current 링크만 바꾼다. 반쯤 바뀐 사이트는 보이지 않는다.
	root * /srv/site/current

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# 오픈 전 미리보기 주소가 검색에 잡히지 않게. 오픈 날 .env 의 SITE_ROBOTS 를 all 로 바꾼다.
		X-Robots-Tag "{$SITE_ROBOTS}"
		# 1년 HTTPS 고정. 정식 도메인으로 오픈한 뒤에 켠다 — 한 번 켜면 http 로는 못 돌아간다.
		# Strict-Transport-Security "max-age=31536000"
	}

	# 이름에 내용 해시가 붙는 파일은 1년 캐시. 나머지(HTML · 사진)는 매번 바뀌었는지 확인한다(ETag).
	@hashed path /_next/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@other not path /_next/static/*
	header @other Cache-Control "public, max-age=0, must-revalidate"

	# 정적 내보내기는 /products/ → /products/index.html 이다(next.config trailingSlash).
	# 폴더 주소에 / 가 빠지면 file_server 가 / 를 붙여 돌려보낸다.
	file_server

	# 없는 주소는 Next 가 만든 404 화면으로 (상태 코드는 404 그대로)
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}

	log {
		output stdout
		format console
	}
}

# ── API ──────────────────────────────────────────────────────
{$API_DOMAIN} {
	encode zstd gzip

	# 업로드 상한과 맞춘다 (spring.servlet.multipart.max-request-size = 12MB).
	# 프록시가 먼저 끊어야 12MB 넘는 요청이 API 까지 오지 않는다.
	request_body {
		max_size 12MB
	}

	reverse_proxy api:8080 {
		# API 가 죽었을 때 Caddy 가 502 로 답한다. 헬스체크는 compose 가 본다.
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}

	header {
		# 서버 종류를 굳이 알려주지 않는다.
		-Server
		# 1년 HTTPS 고정. 정식 도메인으로 오픈한 뒤에 켠다 — 한 번 켜면 http 로는 못 돌아간다.
		# Strict-Transport-Security "max-age=31536000"
	}

	log {
		output stdout
		format console
	}
}
