# 모든 텍스트 파일은 저장소에 LF 로 저장한다 (Windows/macOS 혼용 대비)
* text=auto eol=lf

# Windows 전용 스크립트는 CRLF 유지
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Gradle wrapper
gradlew     text eol=lf
gradlew.bat text eol=crlf

# 바이너리 (diff/eol 변환 금지)
*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary
